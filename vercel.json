{
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/sw\\.js",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "CDN-Cache-Control": "no-store",
        "Cloudflare-CDN-Cache-Control": "no-store",
        "Service-Worker-Allowed": "/"
      },
      "continue": true
    },
    {
      "src": "/(?:.*\\.html|[^.]*)",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "CDN-Cache-Control": "no-store",
        "Cloudflare-CDN-Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "/split(?:/|\\.html|/index\\.html)?",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "CDN-Cache-Control": "public, max-age=31536000, immutable",
        "Cloudflare-CDN-Cache-Control": "public, max-age=31536000, immutable",
        "Cross-Origin-Resource-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "/fonts/watermark/(?:founder/)?(?:[^/]+-[a-f0-9]{12,16}(?:-[0-9]+)?|[a-f0-9]{16})\\.(?:woff2?|css)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "CDN-Cache-Control": "public, max-age=31536000, immutable",
        "Cloudflare-CDN-Cache-Control": "public, max-age=31536000, immutable",
        "Cross-Origin-Resource-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "/wasm-vips/(.*)",
      "headers": {
        "Cross-Origin-Resource-Policy": "same-origin"
      },
      "continue": true
    },
    {
      "src": "/index\\.html",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/split\\.html",
      "status": 308,
      "headers": {
        "Location": "/split"
      }
    },
    {
      "src": "/song-paintings\\.html",
      "status": 308,
      "headers": {
        "Location": "/song-paintings"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "CDN-Cache-Control": "no-store",
        "Cloudflare-CDN-Cache-Control": "no-store"
      }
    },
    {
      "src": "/(?:sw\\.js|manifest\\.webmanifest)",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "CDN-Cache-Control": "no-store",
        "Cloudflare-CDN-Cache-Control": "no-store"
      }
    },
    {
      "src": "/split/?",
      "dest": "/split.html"
    },
    {
      "src": "/song-paintings/?",
      "dest": "/song-paintings.html"
    },
    {
      "src": "/(.*)",
      "dest": "/app.html"
    }
  ]
}
